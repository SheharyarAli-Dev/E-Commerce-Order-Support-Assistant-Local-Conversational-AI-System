# ShopBot Environment Configuration
# Copy this file to .env and adjust values as needed

# Ollama server URL (default: local)
OLLAMA_HOST=http://localhost:11434

# Model to use (must be pulled via 'ollama pull <model>')
SHOPBOT_MODEL=qwen2.5:1.5b

# Generation parameters
SHOPBOT_TEMPERATURE=0.3
SHOPBOT_TOP_P=0.9
SHOPBOT_MAX_TOKENS=512

# Context window budget (tokens reserved for conversation history)
SHOPBOT_MAX_HISTORY_TOKENS=1800
SHOPBOT_MIN_HISTORY_TURNS=2

# Session timeout in seconds (30 minutes)
SHOPBOT_SESSION_TIMEOUT=1800
